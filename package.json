    "release:gates": "bash scripts/release-gates.sh",
    "perf:measure": "vitest run --config vitest.perf.config.mts src/lib/performance",
    "release:report": "vitest run --config vitest.perf.config.mts src/lib/release/release-readiness.report.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
