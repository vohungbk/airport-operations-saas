{
  "name": "airport-operations-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "vitest run --project unit src/app/design-tokens.test.ts src/lib/accessibility/token-contrast.test.ts",
    "build": "next build",
    "start": "next start",
    "demo:reset": "bash scripts/demo-reset.sh",
    "demo:verify": "vitest run src/lib/demo",
    "demo:determinism": "bash scripts/demo-determinism.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
