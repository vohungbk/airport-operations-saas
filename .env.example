# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...), replaces the legacy anon
# key. Safe to expose to the browser — access is enforced by RLS policies,
# not by keeping this secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...), replaces the legacy service-role key.
# Server-only. NEVER prefix with NEXT_PUBLIC_ and NEVER import it into any
# client component. Not used by the foundation yet — add it only when a
# feature requires bypassing RLS from trusted server code.
# SUPABASE_SECRET_KEY=
