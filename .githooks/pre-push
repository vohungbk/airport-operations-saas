#!/bin/bash
# pre-push hook — verification before pushing

echo "Running pre-push checks..."

npm run lint || exit 1
npm run test || exit 1
npm run build || exit 1

# If any check failed, prevent push
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Pre-push checks failed. Fix the issues above before pushing."
  echo ""
  exit 1
fi

echo "✅ All pre-push checks passed"
exit 0
